{
  "name": "xixi-beauty-cam",
  "version": "0.2.0",
  "private": true,
  "description": "In-browser beauty camera with whole-frame color filters and per-face beauty you can switch off person by person.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hohshen/xixi-beauty-cam.git"
  },
  "homepage": "https://github.com/hohshen/xixi-beauty-cam#readme",
  "bugs": {
    "url": "https://github.com/hohshen/xixi-beauty-cam/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/presets.test.mjs && node tests/preset-format.test.mjs && node tests/pwa.test.mjs && node scripts/validate-presets.mjs",
    "validate:presets": "node scripts/validate-presets.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD --verbose",
    "format": "prettier --write .",
    "start": "python3 -m http.server 8000 --directory app"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
